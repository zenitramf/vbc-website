---
import { Image } from "astro:assets";
import heroBg from "@/images/home-page_fvbc_hero.webp";
import { Button } from "@/components/starwind/button";

const navLinks = [
  { href: "#heaven", label: "Heaven" },
  { href: "#about", label: "About Us" },
  { href: "#sermons", label: "Sermons" },
  { href: "#give", label: "Give" },
];
---

<section class="hero">
  <!-- Background image -->
  <Image
    src={heroBg}
    alt="Fresno Victory Baptist Church"
    class="hero__bg"
    widths={[640, 1280, 1920]}
    sizes="100vw"
    loading="eager"
  />

  <!-- Gradient overlay: light on left, darker on right to make text pop -->
  <div class="hero__overlay"></div>

  <!-- Hidden checkbox — drives the CSS-only mobile menu toggle -->
  <input
    type="checkbox"
    id="hero-nav-cbox"
    class="hero__cbox"
    aria-hidden="true"
  />

  <!-- Navigation bar -->
  <nav class="hero__nav" aria-label="Main navigation">
    <!-- Logo -->
    <div class="hero__logo">
      <Image
        src="/vbc_logo.svg"
        alt="Victory Baptist Church"
        width={56}
        height={56}
        class="hero__logo-img"
      />
    </div>

    <!-- Desktop nav links (hidden on mobile) -->
    <ul class="hero__nav-links" role="list">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} class="hero__nav-link">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Desktop CTA (hidden on mobile) -->
    <div class="hero__nav-cta">
      <Button variant="cta" size="sm" href="#visit">Plan a Visit</Button>
    </div>

    <!-- Mobile hamburger label (hidden on desktop) -->
    <label for="hero-nav-cbox" class="hero__hamburger" aria-label="Toggle menu">
      <span class="hero__hamburger-bar"></span>
      <span class="hero__hamburger-bar"></span>
      <span class="hero__hamburger-bar"></span>
    </label>
  </nav>

  <!-- Mobile menu overlay -->
  <div class="hero__mobile-menu" id="mobile-menu">
    <ul class="hero__mobile-links" role="list">
      {
        navLinks.map((link) => (
          <li class="hero__mobile-item">
            <a href={link.href} class="hero__mobile-link">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="hero__mobile-cta">
      <a href="#visit" class="hero__mobile-cta-btn">Plan a Visit</a>
    </div>
  </div>

  <!-- Hero content -->
  <div class="hero__content">
    <!-- Large headline — left column -->
    <h1 class="hero__headline">
      Bible-Centered.<br />Christ Focused
    </h1>

    <!-- Right column — subtitle + CTAs -->
    <div class="hero__right">
      <div class="hero__tagline">
        <p class="hero__church-name">Welcome to Victory Baptist Church</p>
        <p class="hero__location">Independent, Fundamental</p>
      </div>

      <Button variant="cta"> Plan a Visit </Button>
      <Button variant="outline">View Sermons</Button>
    </div>
  </div>
</section>

<script>
  const cbox = document.querySelector(
    "#hero-nav-cbox"
  ) as HTMLInputElement | null;

  const closeMenu = () => {
    if (cbox) {
      cbox.checked = false;
    }
    document.body.style.overflow = "";
  };

  // Lock body scroll when menu opens, release when it closes
  cbox?.addEventListener("change", () => {
    document.body.style.overflow = cbox.checked ? "hidden" : "";
  });

  // Close on any nav link click inside the mobile menu
  for (const link of document.querySelectorAll(".hero__mobile-link")) {
    link.addEventListener("click", closeMenu);
  }

  // Close on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && cbox?.checked) {
      closeMenu();
    }
  });

  // ── Nav scroll state (desktop only) ─────────────────────────────
  const nav = document.querySelector(".hero__nav") as HTMLElement | null;

  function updateNav() {
    if (!nav) return;
    const isDesktop = window.innerWidth >= 768;
    nav.classList.toggle("hero__nav--scrolled", isDesktop && window.scrollY > 10);
  }

  window.addEventListener("scroll", updateNav, { passive: true });
  window.addEventListener("resize", updateNav, { passive: true });
  updateNav();
</script>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  /* Subtle gradient — keeps image vivid, darkens edges for legibility */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgba(0, 0, 0, 0.55) 0%,
        rgba(0, 0, 0, 0.25) 50%,
        rgba(0, 0, 0, 0.45) 100%
      ),
      linear-gradient(to top, rgba(0, 0, 0, 0.4) 0%, transparent 60%);
  }

  /* ── Navigation ─────────────────────────────────── */

  /* Mobile: absolute, transparent, no scroll effect */
  .hero__nav {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 2rem;
    background: transparent;
  }

  /* Scrolled state — desktop only (applied via media query below) */
  .hero__nav--scrolled {
    /* intentionally empty on mobile */
  }

  /* Desktop CTA — hidden on mobile, and hidden until scrolled */
  .hero__nav-cta {
    display: none;
  }

  .hero__logo-img {
    width: 3.5rem;
    height: 3.5rem;
    filter: brightness(0) invert(1);
    display: block;
  }

  /* Desktop nav links — hidden on mobile */
  .hero__nav-links {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 2rem;
  }

  .hero__nav-link {
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: color 0.15s ease;
  }

  .hero__nav-link:hover {
    color: #fff;
  }

  /* ── Hidden checkbox ───────────────────────────── */

  .hero__cbox {
    display: none;
  }

  /* ── Hamburger label — visible on mobile only ───── */

  .hero__hamburger {
    position: relative;
    display: block; /* shown on mobile */
    width: 44px;
    height: 44px;
    overflow: hidden;
    background-color: transparent;
    cursor: pointer;
    transition: background-color 300ms ease-in-out;
  }

  /* Individual bars — reference centering trick */
  .hero__hamburger-bar {
    position: absolute;
    display: block;
    background-color: #fff;
    width: 26px;
    height: 2px;
    border-radius: 2px;
    left: 50%;
    transform: translate(-50%, -50%);
    transition: all 300ms ease-in-out;
  }

  .hero__hamburger-bar:nth-child(1) {
    top: 35%;
  }
  .hero__hamburger-bar:nth-child(2) {
    top: 50%;
  }
  .hero__hamburger-bar:nth-child(3) {
    top: 65%;
  }

  /* ── Checked state: bars become an X ───────────── */

  #hero-nav-cbox:checked ~ .hero__nav .hero__hamburger-bar:nth-child(1) {
    top: 50%;
    transform: translate(-50%, -50%) rotate(45deg);
  }
  #hero-nav-cbox:checked ~ .hero__nav .hero__hamburger-bar:nth-child(2) {
    left: -150%; /* slide center bar out of sight */
  }
  #hero-nav-cbox:checked ~ .hero__nav .hero__hamburger-bar:nth-child(3) {
    top: 50%;
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  /* ── Mobile menu overlay ────────────────────────── */

  .hero__mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(0, 0, 0, 0.95);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* Grow from top-right corner (hamburger position) */
    clip-path: circle(0% at calc(100% - 2rem - 22px) calc(1.5rem + 22px));
    transition: clip-path 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Open state driven by the checkbox sibling */
  #hero-nav-cbox:checked ~ .hero__mobile-menu {
    clip-path: circle(150% at calc(100% - 2rem - 22px) calc(1.5rem + 22px));
  }

  /* Raise nav above the overlay when open so the X label stays clickable */
  .hero:has(#hero-nav-cbox:checked) .hero__nav {
    z-index: 101;
  }

  /* Hide logo when mobile menu is open */
  .hero:has(#hero-nav-cbox:checked) .hero__logo {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .hero__logo {
    transition: opacity 0.2s ease;
  }

  .hero__mobile-links {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
  }

  .hero__mobile-item {
    width: 100%;
  }

  .hero__mobile-item:not(:last-child) {
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .hero__mobile-link {
    display: block;
    width: 100%;
    text-align: center;
    padding: 1.25rem 2rem;
    color: #fff;
    text-decoration: none;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    transition: color 0.15s ease;
  }

  .hero__mobile-link:hover {
    color: rgba(255, 255, 255, 0.65);
  }

  .hero__mobile-cta {
    position: absolute;
    bottom: 2.5rem;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    padding-inline: 2rem;
  }

  .hero__mobile-cta-btn {
    display: block;
    width: 100%;
    max-width: 320px;
    text-align: center;
    padding: 1rem 2rem;
    background: #fff;
    color: #000;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    border-radius: 0.375rem;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .hero__mobile-cta-btn:hover {
    background: rgba(255, 255, 255, 0.85);
  }

  /* ── Hero content ───────────────────────────────── */

  .hero__content {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 2rem;
  }

  .hero__headline {
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 800;
    line-height: 1.05;
    color: #fff;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .hero__right {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .hero__church-name {
    font-size: 1.125rem;
    font-weight: 700;
    color: #fff;
    margin: 0;
  }

  .hero__location {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.75);
    margin: 0.25rem 0 0;
  }

  /* ── Responsive breakpoints ─────────────────────── */

  @media (min-width: 768px) {
    .hero__nav {
      /* 3-col grid: logo | links | cta
         CTA column starts at 0 width and grows on scroll */
      position: fixed;
      display: grid;
      grid-template-columns: 1fr auto 0fr;
      align-items: center;
      padding: 1.75rem 4rem;
      transition:
        background 0.3s ease,
        padding 0.3s ease,
        box-shadow 0.3s ease,
        grid-template-columns 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .hero__nav--scrolled {
      background: #333333;
      box-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
      /* CTA column opens up to match its natural width */
      grid-template-columns: 1fr auto 1fr;
      padding-top: 0.875rem;
      padding-bottom: 0.875rem;
    }

    .hero__hamburger {
      display: none;
    }

    /* Links: right-aligned in middle column by default */
    .hero__nav-links {
      display: flex;
      justify-content: flex-end;
      transition: justify-content 0.4s ease;
    }

    /* When scrolled, links center themselves in the middle column */
    .hero__nav--scrolled .hero__nav-links {
      justify-content: center;
    }

    /* CTA: hidden (zero width, no opacity) until scrolled */
    .hero__nav-cta {
      display: flex;
      justify-content: flex-end;
      overflow: hidden;
      opacity: 0;
      transform: translateX(8px);
      transition: opacity 0.25s ease 0.1s, transform 0.25s ease 0.1s;
      pointer-events: none;
    }

    .hero__nav--scrolled .hero__nav-cta {
      opacity: 1;
      transform: translateX(0);
      pointer-events: auto;
    }

    .hero__content {
      padding-inline: 4rem;
    }
  }

  @media (min-width: 1024px) {
    .hero__nav {
      padding-inline: 6rem;
    }

    .hero__content {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      padding-inline: 6rem;
    }
  }


</style>
