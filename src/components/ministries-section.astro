---
import { Button } from "@/components/starwind/button";
import { ministries } from "@/lib/church-data";

const featured = ministries.find((m) => m.featured) ?? ministries[0];
const others = ministries.filter((m) => m.id !== featured.id);
---

<section
  id="ministries"
  class="relative overflow-hidden bg-background px-8 py-24 md:px-16 lg:px-24"
>
  <div class="relative mx-auto max-w-5xl">
    <div class="reveal max-w-2xl">
      <p class="mb-4 text-sm font-bold uppercase tracking-[0.2em] text-primary">
        Ministries
      </p>
      <h2
        class="font-display text-4xl font-bold tracking-tight text-foreground md:text-5xl"
      >
        Outreach is our heartbeat.
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
        Every ministry at Victory Baptist Church serves one mission: reaching
        Fresno — and the world — with the gospel of Jesus Christ.
      </p>
    </div>

    <div
      id={featured.id}
      class="reveal reveal-delay-1 mt-14 grid gap-6 border-y border-border py-12 md:grid-cols-[1fr_1.6fr] md:gap-16"
    >
      <div>
        <h3 class="font-display text-3xl font-bold text-foreground">
          {featured.name}
        </h3>
        <p class="mt-2 text-muted-foreground">
          Every week, in our city and beyond.
        </p>
      </div>
      <div>
        <p class="text-lg leading-relaxed text-muted-foreground">
          {featured.summary}
        </p>
        <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
          You don't need experience to come along — just a willing heart. We'll
          pair you with someone and show you how.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-6">
          <Button href="/salvation/" size="lg">Bible Way to Heaven</Button>
          <a
            class="font-semibold text-primary underline-offset-4 hover:underline"
            href="/events/"
          >
            See outreach times
          </a>
        </div>
      </div>
    </div>

    <ul
      class="reveal reveal-delay-2 mt-10 grid list-none grid-cols-1 gap-x-16 gap-y-8 p-0 md:grid-cols-2"
      role="list"
    >
      {
        others.map((ministry) => (
          <li id={ministry.id} class="border-border pt-6">
            <h3 class="mb-2 font-display text-2xl font-bold text-foreground">
              {ministry.name}
            </h3>
            <p class="leading-relaxed text-muted-foreground">
              {ministry.summary}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
