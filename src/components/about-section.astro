---
import { unsplash } from "@/lib/unsplash";
---

<section
  id="about"
  class="relative overflow-hidden bg-accent px-8 py-24 md:px-16 lg:px-24"
>
  <div
    class="pointer-events-none absolute inset-0 opacity-40"
    style={`background-image: url('${unsplash.worship}'); background-size: cover; background-position: center;`}
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-0 bg-linear-to-br from-accent via-accent/95 to-primary/25"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-3xl text-center">
    <h2
      class="reveal mb-6 font-display text-4xl font-bold tracking-tight text-accent-foreground md:text-5xl"
    >
      A living church family rooted in Scripture
    </h2>
    <p
      class="reveal reveal-delay-1 text-lg leading-relaxed text-accent-foreground/80"
    >
      Victory Baptist Church is a Bible-believing congregation in Fresno. We
      gather every Sunday to worship, grow in God's Word, and serve our city
      together. Whether you've walked with Jesus for decades or you're still
      asking questions, come grow with us.
    </p>
    <p class="reveal reveal-delay-2 mt-8">
      <a
        href="/about-vbc/"
        class="text-sm font-bold uppercase tracking-[0.14em] text-primary underline-offset-4 hover:underline"
      >
        Learn More About VBC →
      </a>
    </p>
  </div>
</section>
