---
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";
import type { VariantProps } from "tailwind-variants";

interface Props
  extends
    HTMLAttributes<"button">,
    Omit<HTMLAttributes<"a">, "type">,
    VariantProps<typeof button> {}

const { variant, size, class: className, ...rest } = Astro.props;

export const button = tv({
  base: [
    "inline-flex items-center justify-center gap-1.5 rounded-md font-medium whitespace-nowrap",
    "[&_svg]:pointer-events-none [&_svg]:shrink-0",
    "transition-all outline-none focus-visible:ring-3",
    "disabled:pointer-events-none disabled:opacity-50",
    "aria-invalid:border-error aria-invalid:focus-visible:ring-error/40",
  ],
  defaultVariants: { size: "md", variant: "primary" },
  variants: {
    size: {
      icon: "size-11 [&_svg:not([class*='size-'])]:size-4.5",
      "icon-lg": "size-12 [&_svg:not([class*='size-'])]:size-5",
      "icon-sm": "size-9 [&_svg:not([class*='size-'])]:size-3.5",
      lg: "h-12 px-8 text-lg has-[>svg]:px-6 [&_svg:not([class*='size-'])]:size-5",
      md: "h-11 px-5 text-base has-[>svg]:px-4 [&_svg:not([class*='size-'])]:size-4.5",
      sm: "h-9 px-4 text-sm has-[>svg]:px-3 [&_svg:not([class*='size-'])]:size-3.5",
    },
    variant: {
      cta: "bg-cta text-cta-foreground hover:bg-cta/90 focus-visible:ring-cta/50",
      outline:
        "bg-transparent text-white border border-white hover:bg-white/10 focus-visible:ring-white/50",
      primary:
        "bg-primary text-primary-foreground hover:bg-primary/90 focus-visible:ring-primary/50",
      secondary:
        "bg-secondary text-secondary-foreground hover:bg-secondary/80 border border-border focus-visible:ring-outline/50",
    },
  },
});

const Tag = Astro.props.href ? "a" : "button";
---

<Tag
  class={button({ variant, size, class: className })}
  data-slot="button"
  {...rest}
>
  <slot />
</Tag>
