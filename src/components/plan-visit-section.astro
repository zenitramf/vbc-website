---
import { Button } from "@/components/starwind/button";
import { serviceTimes } from "@/lib/church-data";
import { unsplash } from "@/lib/unsplash";

const { bibleStudy, sundayMorning, sundaySchool } = serviceTimes;
---

<section
  id="visit"
  class="relative overflow-hidden bg-background px-8 py-24 md:px-16 lg:px-24"
>
  <div
    class="relative mx-auto grid max-w-6xl grid-cols-1 items-center gap-14 lg:grid-cols-2"
  >
    <div class="reveal relative overflow-hidden aspect-4/3">
      <img
        src={unsplash.service}
        alt="Congregation gathered for Sunday worship"
        class="h-full w-full object-cover"
        width="1400"
        height="1050"
        loading="lazy"
        decoding="async"
      />
      <div
        class="pointer-events-none absolute inset-0 bg-linear-to-t from-primary/35 via-transparent to-transparent"
        aria-hidden="true"
      >
      </div>
    </div>

    <div class="reveal reveal-delay-1 flex flex-col gap-6">
      <p
        class="text-sm font-bold uppercase tracking-[0.2em] text-primary"
      >
        Plan Your Visit
      </p>
      <h2
        class="font-display text-4xl font-bold tracking-tight text-foreground md:text-5xl"
      >
        We'd love to meet you this week
      </h2>
      <p class="text-lg leading-relaxed text-muted-foreground">
        Come as you are. Find a seat, meet friendly faces, and hear the gospel
        preached clearly from Scripture.
      </p>
      <ul class="flex flex-col gap-4 text-muted-foreground">
        <li class="flex items-start gap-3">
          <span
            class="mt-2 h-2.5 w-2.5 shrink-0 rounded-sm bg-cta"
            aria-hidden="true"></span>
          <span>
            <strong class="text-foreground">Thursday Bible Study</strong> — {
              bibleStudy.time
            }
          </span>
        </li>
        <li class="flex items-start gap-3">
          <span
            class="mt-2 h-2.5 w-2.5 shrink-0 rounded-sm bg-primary"
            aria-hidden="true"></span>
          <span>
            <strong class="text-foreground">Sunday</strong> — {
              sundaySchool.time
            } Bible Study · {sundayMorning.time} Main Service
          </span>
        </li>
        <li class="flex items-start gap-3">
          <span
            class="mt-2 h-2.5 w-2.5 shrink-0 rounded-sm bg-primary"
            aria-hidden="true"></span>
          <span>
            <strong class="text-foreground">Location</strong> — 1717 N Gateway
            Blvd Ste. #105, Fresno, CA 93727
          </span>
        </li>
      </ul>
      <div>
        <Button
          href="https://maps.app.goo.gl/Ysiz9UYS1mijVrJH7"
          target="_blank"
          rel="noopener noreferrer"
          size="lg"
        >
          Open in Google Maps
        </Button>
      </div>
    </div>
  </div>
</section>
