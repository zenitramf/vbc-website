---
import { Button } from "@/components/starwind/button";
import churchFrontage from "@/images/church_frontage.webp";
import { churchInfo, serviceTimes } from "@/lib/church-data";

const { bibleStudy, sundayMorning, sundaySchool } = serviceTimes;
---

<section
  id="visit"
  class="relative isolate overflow-hidden bg-[#050d1c] px-8 py-24 md:px-16 lg:px-24 lg:py-32"
>
  <img
    src={churchFrontage.src}
    alt=""
    class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
    width={churchFrontage.width}
    height={churchFrontage.height}
    loading="lazy"
    decoding="async"
  />
  <div
    class="absolute inset-0 -z-10 bg-[#050d1c]/85 bg-linear-to-r from-[#050d1c] via-[#050d1c]/85 to-[#050d1c]/30"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 -z-10 bg-linear-to-t from-[#050d1c]/70 via-transparent to-[#050d1c]/20"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl">
    <div class="reveal max-w-3xl">
      <div class="mb-6 flex items-center gap-4">
        <span class="h-px w-10 bg-cta" aria-hidden="true"></span>
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-white/75">
          Plan Your Visit
        </p>
      </div>
      <h2
        class="font-display text-4xl font-bold leading-[1.05] tracking-tight text-white md:text-6xl lg:text-7xl"
      >
        We'd love to meet you this week
      </h2>
      <p
        class="mt-6 max-w-2xl text-lg leading-relaxed text-white/80 md:text-xl"
      >
        Come visit us, Find a seat, meet friendly faces, and hear the gospel
        preached clearly from Scripture.
      </p>
    </div>

    <ul
      class="reveal reveal-delay-1 mt-12 grid max-w-4xl divide-y divide-white/20 border-y border-white/25 text-white/75 md:grid-cols-3 md:divide-x md:divide-y-0"
    >
      <li class="flex flex-col gap-2 px-6 py-5 md:first:pl-0">
        <strong class="text-white">Thursday Bible Study</strong>
        <span>{bibleStudy.time}</span>
      </li>
      <li class="flex flex-col gap-2 px-6 py-5">
        <strong class="text-white">Sunday</strong>
        <span>
          {sundaySchool.time} Bible Study · {sundayMorning.time} Main Service
        </span>
      </li>
      <li class="flex flex-col gap-2 px-6 py-5 md:last:pr-0">
        <strong class="text-white">Location</strong>
        <span>1717 N Gateway Blvd Ste. #105, Fresno, CA 93727</span>
      </li>
    </ul>

    <div class="reveal reveal-delay-2 mt-9 flex flex-wrap gap-3">
      <Button href="/visit/" size="lg" variant="cta">Plan Your Visit</Button>
      <Button href={churchInfo.mapsUrl} size="lg" variant="outline">
        Open in Google Maps
      </Button>
    </div>
  </div>
</section>
