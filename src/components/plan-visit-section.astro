---
import { Image } from "astro:assets";
import heroBg from "@/images/home-page_fvbc_hero.webp";
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import { serviceTimes } from "@/lib/church-data";

const { bibleStudy, sundayMorning, sundayNight, sundaySchool } = serviceTimes;
---

<section class="bg-muted py-20 px-8 md:px-16 lg:px-24">
  <div
    class="max-w-6xl mx-auto grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center"
  >
    <!-- Image -->
    <div class="relative overflow-hidden rounded-xl aspect-4/3">
      <Image
        src={heroBg}
        alt="Sunday service at Victory Baptist Church"
        class="h-full w-full object-cover"
        widths={[600, 900]}
        sizes="(max-width: 1024px) 100vw, 50vw"
      />
    </div>

    <!-- Content -->
    <div class="flex flex-col gap-6">
      <Badge class="self-start">Plan Your Visit</Badge>
      <h2 class="text-3xl font-bold text-foreground md:text-4xl">
        We'd love to meet you.
      </h2>
      <ul class="flex flex-col gap-3 text-muted-foreground">
        <li class="flex items-start gap-3">
          <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-primary"></span>
          <span
            ><strong class="text-foreground">Thursday Bible Study</strong> — {
              bibleStudy.time
            }
          </span>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-primary"></span>
          <span
            ><strong class="text-foreground">Sunday Service</strong> — {
              sundaySchool.time
            } Bible Study | {sundayMorning.time} Main Service</span
          >
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-primary"></span>
          <span
            ><strong class="text-foreground">Location</strong> — 1717 N Gateway Blvd
            Ste. #105, Fresno, CA 93727</span
          >
        </li>
      </ul>
      <div>
        <Button
          href="https://maps.app.goo.gl/Ysiz9UYS1mijVrJH7"
          target="_blank"
          rel="noopener noreferrer"
        >
          Open in Google Maps
        </Button>
      </div>
    </div>
  </div>
</section>
