---
import { Button } from "@/components/starwind/button";
import { unsplash } from "@/lib/unsplash";
---

<section class="relative overflow-hidden bg-background px-8 py-24 md:px-16 lg:px-24">
  <div
    class="relative mx-auto grid max-w-6xl grid-cols-1 items-center gap-14 lg:grid-cols-2"
  >
    <div class="reveal flex flex-col gap-6 lg:order-1">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-primary">
        Next Steps
      </p>
      <h2
        class="font-display text-4xl font-bold tracking-tight text-foreground md:text-5xl"
      >
        Ready to go deeper?
      </h2>
      <p class="text-lg leading-relaxed text-muted-foreground">
        Whether you're brand new or have been coming for years, there's always a
        next step. Join a small group, serve on a team, or talk with a pastor —
        we'll help you find where you belong.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <Button size="lg" href="/#ministries">Explore Ministries</Button>
        <Button size="lg" variant="secondary" href="/#soul-winning">
          Soul-Winning
        </Button>
      </div>
    </div>

    <div class="reveal reveal-delay-1 relative overflow-hidden aspect-4/3 lg:order-2">
      <img
        src={unsplash.nextSteps}
        alt="People serving and growing together in community"
        class="h-full w-full object-cover"
        width="1400"
        height="1050"
        loading="lazy"
        decoding="async"
      />
      <div
        class="pointer-events-none absolute inset-0 bg-linear-to-br from-primary/30 via-transparent to-cta/25"
        aria-hidden="true"
      >
      </div>
    </div>
  </div>
</section>
