---
import { ArrowRight, Calendar, Users } from "lucide-react";
import { Button } from "@/components/starwind/button";
---

<section
  id="connect"
  class="bg-muted px-8 py-24 md:px-16 lg:px-24"
>
  <div class="mx-auto max-w-6xl">
    <div class="reveal mb-14 max-w-2xl">
      <p class="mb-4 text-sm font-bold uppercase tracking-[0.2em] text-primary">
        Get Connected
      </p>
      <h2
        class="font-display text-4xl font-bold tracking-tight text-foreground md:text-5xl"
      >
        Real people. Real community.
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      <a
        href="/meet-the-staff/"
        class="reveal group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-background p-8 transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-primary/50 md:p-10"
      >
        <Users
          className="absolute -right-8 -top-8 size-44 rotate-12 text-primary/[0.05] transition-transform duration-500 group-hover:rotate-6 group-hover:scale-110"
          aria-hidden="true"
        />
        <span
          class="mb-8 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-accent text-accent-foreground"
        >
          <Users className="size-6" aria-hidden="true" />
        </span>
        <p
          class="mb-2 text-sm font-bold uppercase tracking-[0.18em] text-primary"
        >
          Our Team
        </p>
        <h3 class="mb-2 font-display text-2xl font-bold text-foreground">
          Meet the pastors &amp; leaders
        </h3>
        <p class="text-muted-foreground leading-relaxed">
          Get to know the men and women who shepherd our congregation and serve
          Fresno with humility and love.
        </p>
        <span
          class="mt-auto inline-flex items-center gap-2 pt-6 text-sm font-semibold text-primary transition-colors group-hover:text-primary-accent"
        >
          Meet Our Staff
          <ArrowRight
            className="size-4 transition-transform duration-300 group-hover:translate-x-1"
            aria-hidden="true"
          />
        </span>
      </a>

      <a
        href="/events/"
        class="reveal reveal-delay-1 group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-background p-8 transition-all duration-300 hover:-translate-y-1 hover:border-cta/40 hover:shadow-xl focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-primary/50 md:p-10"
      >
        <Calendar
          className="absolute -right-8 -top-8 size-44 rotate-12 text-cta/[0.05] transition-transform duration-500 group-hover:rotate-6 group-hover:scale-110"
          aria-hidden="true"
        />
        <span
          class="mb-8 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-cta/10 text-cta"
        >
          <Calendar className="size-6" aria-hidden="true" />
        </span>
        <p class="mb-2 text-sm font-bold uppercase tracking-[0.18em] text-cta">
          Events
        </p>
        <h3 class="mb-2 font-display text-2xl font-bold text-foreground">
          What's coming up
        </h3>
        <p class="text-muted-foreground leading-relaxed">
          From Sunday services to outreach nights, there's always something
          happening at VBC. Come be part of it.
        </p>
        <span
          class="mt-auto inline-flex items-center gap-2 pt-6 text-sm font-semibold text-primary transition-colors group-hover:text-primary-accent"
        >
          View Calendar
          <ArrowRight
            className="size-4 transition-transform duration-300 group-hover:translate-x-1"
            aria-hidden="true"
          />
        </span>
      </a>
    </div>

    <div class="reveal mt-12 flex flex-wrap gap-3">
      <Button href="/sermons/" size="lg">Browse Sermons</Button>
      <Button href="/visit/" variant="secondary" size="lg">Plan a Visit</Button>
    </div>
  </div>
</section>
