---
import { Button } from "@/components/starwind/button";
import { unsplash } from "@/lib/unsplash";
---

<section
  id="connect"
  class="bg-muted px-8 py-24 md:px-16 lg:px-24"
>
  <div class="mx-auto max-w-6xl">
    <div class="reveal mb-14 max-w-2xl">
      <p class="mb-4 text-sm font-bold uppercase tracking-[0.2em] text-primary">
        Get Connected
      </p>
      <h2
        class="font-display text-4xl font-bold tracking-tight text-foreground md:text-5xl"
      >
        Real people. Real community.
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
      <a
        href="/meet-the-staff/"
        class="reveal group block focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-primary/50"
      >
        <div class="relative mb-5 aspect-video overflow-hidden">
          <img
            src={unsplash.staff}
            alt="Pastors and leaders serving together"
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            width="1400"
            height="788"
            loading="lazy"
            decoding="async"
          />
          <div
            class="pointer-events-none absolute inset-0 bg-linear-to-t from-foreground/45 via-transparent to-transparent"
            aria-hidden="true"
          >
          </div>
        </div>
        <p class="mb-2 text-sm font-bold uppercase tracking-[0.18em] text-primary">
          Our Team
        </p>
        <h3 class="mb-2 font-display text-2xl font-bold text-foreground">
          Meet the pastors &amp; leaders
        </h3>
        <p class="mb-5 text-muted-foreground leading-relaxed">
          Get to know the men and women who shepherd our congregation and serve
          Fresno with humility and love.
        </p>
        <span
          class="inline-flex text-sm font-semibold text-primary transition-colors group-hover:text-primary-accent"
        >
          Meet Our Staff →
        </span>
      </a>

      <a
        href="/events/"
        class="reveal reveal-delay-1 group block focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-primary/50"
      >
        <div class="relative mb-5 aspect-video overflow-hidden">
          <img
            src={unsplash.events}
            alt="Church community gathering for an event"
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            width="1400"
            height="788"
            loading="lazy"
            decoding="async"
          />
          <div
            class="pointer-events-none absolute inset-0 bg-linear-to-t from-foreground/45 via-transparent to-transparent"
            aria-hidden="true"
          >
          </div>
        </div>
        <p class="mb-2 text-sm font-bold uppercase tracking-[0.18em] text-cta">
          Events
        </p>
        <h3 class="mb-2 font-display text-2xl font-bold text-foreground">
          What's coming up
        </h3>
        <p class="mb-5 text-muted-foreground leading-relaxed">
          From Sunday services to outreach nights, there's always something
          happening at VBC. Come be part of it.
        </p>
        <span
          class="inline-flex text-sm font-semibold text-primary transition-colors group-hover:text-primary-accent"
        >
          View Calendar →
        </span>
      </a>
    </div>

    <div class="reveal mt-12 flex flex-wrap gap-3">
      <Button href="/sermons/" size="lg">Browse Sermons</Button>
      <Button href="/visit/" variant="secondary" size="lg">Plan a Visit</Button>
    </div>
  </div>
</section>
