---
import { Button } from "@/components/starwind/button";
import { giveHref, primaryNav, visitHref } from "@/lib/site-nav";

interface Props {
  variant?: "solid" | "transparent";
  /** When true (desktop only), keep the header hidden until the homepage hero leaves the viewport. Mobile always shows the header. */
  revealAfterHero?: boolean;
}

const { variant = "solid", revealAfterHero = false }: Props = Astro.props;
const { pathname } = Astro.url;
---

<header
  class:list={[
    "site-header",
    variant === "solid" && "site-header--solid",
    revealAfterHero && "site-header--reveal-after-hero",
  ]}
  data-reveal-after-hero={revealAfterHero ? "" : undefined}
>
  <nav class="site-header__nav" aria-label="Main navigation">
    <a
      href="/"
      class="site-header__logo"
      aria-label="Victory Baptist Church home"
    >
      <img
        src="/vbc_logo.svg"
        alt=""
        width="48"
        height="48"
        class="site-header__logo-img"
      />
      <span class="site-header__brand" aria-hidden="true">
        <span class="site-header__brand-primary">Victory</span>
        <span class="site-header__brand-secondary">Baptist Church</span>
      </span>
    </a>

    <ul class="site-header__links" role="list">
      {
        primaryNav.map((item) =>
          item.children ? (
            <li class="site-header__item site-header__item--has-children">
              <button
                type="button"
                class="site-header__link site-header__parent"
              >
                {item.label}
                <span class="site-header__caret" aria-hidden="true">
                  ▾
                </span>
              </button>
              <ul class="site-header__dropdown" role="list">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class:list={[
                        "site-header__dropdown-link",
                        pathname.startsWith(child.href.replace(/\/$/, "")) &&
                          "is-active",
                      ]}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li class="site-header__item">
              <a
                href={item.href}
                class:list={[
                  "site-header__link",
                  item.href &&
                    pathname.startsWith(item.href.replace(/\/$/, "")) &&
                    "is-active",
                ]}
              >
                {item.label}
              </a>
            </li>
          )
        )
      }
      <li class="site-header__item">
        <a
          href={giveHref}
          class="site-header__link"
          target="_blank"
          rel="noopener noreferrer"
        >
          Give
        </a>
      </li>
    </ul>

    <div class="site-header__actions">
      <div class="site-header__cta">
        <Button variant="cta" size="sm" href={visitHref}>Visit Us</Button>
      </div>

      <button
        type="button"
        class="site-header__hamburger"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-mobile-menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <nav
    class="site-header__mobile"
    id="site-mobile-menu"
    aria-label="Mobile navigation"
    aria-hidden="true"
    inert
  >
    <ul class="site-header__mobile-links" role="list">
      {
        primaryNav.flatMap((item) =>
          item.children
            ? item.children.map((child) => (
                <li>
                  <a href={child.href} class="site-header__mobile-link">
                    {child.label}
                  </a>
                </li>
              ))
            : [
                <li>
                  <a href={item.href} class="site-header__mobile-link">
                    {item.label}
                  </a>
                </li>,
              ]
        )
      }
      <li>
        <a
          href={giveHref}
          class="site-header__mobile-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          Give
        </a>
      </li>
    </ul>
    <div class="site-header__mobile-cta">
      <a href={visitHref} class="site-header__mobile-cta-btn">Visit Us</a>
    </div>
  </nav>
</header>
{/* Reserves flow height while the header is position:fixed on mobile. */}
<div class="site-header__spacer" aria-hidden="true"></div>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const menuButton = document.querySelector<HTMLButtonElement>(
    ".site-header__hamburger"
  );
  const mobileMenu = document.querySelector<HTMLElement>("#site-mobile-menu");
  const mobileLinks = [
    ...document.querySelectorAll<HTMLAnchorElement>(
      ".site-header__mobile-link"
    ),
  ];
  const mobileCta = document.querySelector<HTMLAnchorElement>(
    ".site-header__mobile-cta-btn"
  );
  const desktopMedia = window.matchMedia("(min-width: 900px)");

  const isMenuOpen = () => menuButton?.getAttribute("aria-expanded") === "true";

  const synchronizeMenuState = (open: boolean) => {
    menuButton?.setAttribute("aria-expanded", String(open));
    menuButton?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    header?.classList.toggle("site-header--menu-open", open);
    mobileMenu?.classList.toggle("is-open", open);
    mobileMenu?.setAttribute("aria-hidden", String(!open));
    mobileMenu?.toggleAttribute("inert", !open);
    document.body.style.overflow = open ? "hidden" : "";
  };

  const moveMenuFocus = (open: boolean) => {
    if (open) {
      const [firstMobileLink] = mobileLinks;
      window.requestAnimationFrame(() => firstMobileLink?.focus());
      return;
    }

    menuButton?.focus();
  };

  const setMenuOpen = (open: boolean, moveFocus: boolean) => {
    synchronizeMenuState(open);
    if (moveFocus) {
      moveMenuFocus(open);
    }
  };

  // Close without the clip-path animation so Safari's back/forward snapshot
  // never captures the navy overlay mid-collapse.
  const closeMenuForNavigation = () => {
    header?.classList.add("site-header--no-motion");
    setMenuOpen(false, false);
    window.requestAnimationFrame(() => {
      header?.classList.remove("site-header--no-motion");
    });
  };

  const getFocusableElements = () => {
    const logo = header?.querySelector<HTMLAnchorElement>(".site-header__logo");
    return [logo, menuButton, ...mobileLinks, mobileCta].filter(
      (element): element is HTMLElement => element !== null
    );
  };

  const getWrapDestination = (
    event: KeyboardEvent,
    firstElement: HTMLElement | undefined,
    lastElement: HTMLElement | undefined
  ) => {
    if (event.shiftKey && document.activeElement === firstElement) {
      return lastElement;
    }
    if (!event.shiftKey && document.activeElement === lastElement) {
      return firstElement;
    }
  };

  const trapMenuFocus = (event: KeyboardEvent) => {
    if (event.key !== "Tab") {
      return;
    }

    const focusableElements = getFocusableElements();
    const [firstElement] = focusableElements;
    const lastElement = focusableElements.at(-1);
    const destination = getWrapDestination(event, firstElement, lastElement);
    if (destination) {
      event.preventDefault();
      destination.focus();
    }
  };

  menuButton?.addEventListener("click", () => {
    const open = !isMenuOpen();
    setMenuOpen(open, open);
  });

  for (const link of mobileLinks) {
    link.addEventListener("click", closeMenuForNavigation);
  }

  mobileCta?.addEventListener("click", closeMenuForNavigation);

  document.addEventListener("keydown", (event) => {
    if (!isMenuOpen()) {
      return;
    }
    if (event.key === "Escape") {
      event.preventDefault();
      setMenuOpen(false, true);
      return;
    }
    trapMenuFocus(event);
  });

  desktopMedia.addEventListener("change", (event) => {
    if (event.matches && isMenuOpen()) {
      setMenuOpen(false, false);
    }
  });

  const revealAfterHero = header?.dataset.revealAfterHero !== undefined;
  const hero = document.querySelector<HTMLElement>(".hero");

  const setHeaderVisible = (visible: boolean) => {
    if (!header || !revealAfterHero) {
      return;
    }
    header.classList.toggle("is-visible", visible);
    // Only inert/aria-hidden while the desktop reveal effect is hiding the bar.
    const hideFromA11y = desktopMedia.matches && !visible;
    header.toggleAttribute("aria-hidden", hideFromA11y);
    header.toggleAttribute("inert", hideFromA11y);
    if (!visible && isMenuOpen()) {
      setMenuOpen(false, false);
    }
  };

  const syncRevealAfterHero = () => {
    if (!revealAfterHero || !header) {
      return;
    }
    // Mobile: always show. Desktop: show only once the hero has left view.
    if (!desktopMedia.matches) {
      setHeaderVisible(true);
      return;
    }
    if (!hero) {
      setHeaderVisible(true);
      return;
    }
    setHeaderVisible(hero.getBoundingClientRect().bottom <= 0);
  };

  if (revealAfterHero && header && hero && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry) {
          return;
        }
        if (!desktopMedia.matches) {
          setHeaderVisible(true);
          return;
        }
        setHeaderVisible(!entry.isIntersecting);
      },
      { threshold: 0 }
    );

    observer.observe(hero);
  }

  syncRevealAfterHero();
  desktopMedia.addEventListener("change", syncRevealAfterHero);

  // BFCache restore can replay in-flight header transitions; suppress for
  // one frame so the restored page paints in its settled state.
  window.addEventListener("pageshow", (event) => {
    if (!event.persisted) {
      return;
    }
    header?.classList.add("site-header--no-motion");
    if (isMenuOpen()) {
      setMenuOpen(false, false);
    }
    syncRevealAfterHero();
    window.requestAnimationFrame(() => {
      header?.classList.remove("site-header--no-motion");
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
  }

  /* Desktop-only: hide until the hero scrolls away. Mobile always shows. */
  @media (min-width: 900px) {
    .site-header--reveal-after-hero {
      position: fixed;
      inset-inline: 0;
      top: 0;
      width: 100%;
      transform: translateY(-100%);
      pointer-events: none;
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .site-header--reveal-after-hero.is-visible {
      transform: none;
      pointer-events: auto;
    }
  }

  .site-header--solid {
    background: rgba(15, 39, 68, 0.97);
    box-shadow: 0 1px 12px rgba(0, 0, 0, 0.18);
  }

  .site-header__spacer {
    display: none;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
    padding: 0.875rem 1.5rem;
    max-width: 80rem;
    margin-inline: auto;
    box-sizing: border-box;
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: #fff;
    min-width: 0;
  }

  .site-header__logo-img {
    width: 2.75rem;
    height: 2.75rem;
    filter: brightness(0) invert(1);
    flex-shrink: 0;
  }

  .site-header__brand {
    display: flex;
    flex-direction: column;
    color: rgba(255, 255, 255, 0.72);
    font-family: var(--font-brand);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .site-header__brand-primary {
    color: #fff;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.2em;
  }

  .site-header__brand-secondary {
    margin-top: 0.2rem;
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.2em;
  }

  .site-header__links {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
    gap: 0.25rem;
  }

  .site-header__link,
  .site-header__parent {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 600;
    background: none;
    border: 0;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
  }

  .site-header__link::after,
  .site-header__parent::after {
    content: "";
    position: absolute;
    right: 0.75rem;
    bottom: 0.1rem;
    left: 0.75rem;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, #fde68a, #fbbf24);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header__link.is-active {
    color: #fff;
  }

  .site-header__item--has-children:focus-within .site-header__parent::after {
    transform: scaleX(1);
  }

  @media (hover: hover) {
    .site-header__link:hover,
    .site-header__parent:hover {
      color: #fff;
    }

    .site-header__link:hover::after,
    .site-header__parent:hover::after {
      transform: scaleX(1);
    }
  }

  .site-header__caret {
    font-size: 0.7rem;
    opacity: 0.8;
  }

  .site-header__item--has-children {
    position: relative;
  }

  .site-header__dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 12rem;
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
    background: #0f2744;
    border: 1px solid rgba(255, 255, 255, 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.35rem);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      visibility 0.15s ease;
  }

  .site-header__item--has-children:hover .site-header__dropdown,
  .site-header__item--has-children:focus-within .site-header__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .site-header__dropdown-link {
    display: block;
    padding: 0.6rem 1rem;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .site-header__dropdown-link:hover,
  .site-header__dropdown-link.is-active {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .site-header__cta {
    display: block;
  }

  .site-header__hamburger {
    position: relative;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
    cursor: pointer;
  }

  .site-header__hamburger:focus-visible {
    border-radius: 0.25rem;
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .site-header__hamburger:active {
    opacity: 0.7;
  }

  .site-header__hamburger span {
    position: absolute;
    left: 50%;
    width: 26px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transform: translate(-50%, -50%);
    transition: all 0.25s ease;
  }

  .site-header__hamburger span:nth-child(1) {
    top: 35%;
  }
  .site-header__hamburger span:nth-child(2) {
    top: 50%;
  }
  .site-header__hamburger span:nth-child(3) {
    top: 65%;
  }

  .site-header__hamburger[aria-expanded="true"] span:nth-child(1) {
    top: 50%;
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .site-header__hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .site-header__hamburger[aria-expanded="true"] span:nth-child(3) {
    top: 50%;
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .site-header__mobile {
    position: fixed;
    inset: 0;
    z-index: 30;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 5.5rem 1.25rem 2rem;
    visibility: hidden;
    overflow-y: auto;
    background: rgba(15, 39, 68, 0.98);
    clip-path: circle(0% at calc(100% - 1.5rem - 22px) calc(0.875rem + 22px));
    pointer-events: none;
    transition:
      clip-path 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s linear 0.4s;
  }

  .site-header__mobile.is-open {
    visibility: visible;
    clip-path: circle(150% at calc(100% - 1.5rem - 22px) calc(0.875rem + 22px));
    pointer-events: auto;
    transition-delay: 0s;
  }

  .site-header--menu-open .site-header__nav {
    position: relative;
    z-index: 35;
  }

  .site-header--menu-open .site-header__cta {
    opacity: 0;
    pointer-events: none;
  }

  .site-header__mobile-links {
    list-style: none;
    margin: 0;
    padding: 0;
    width: min(100%, 28rem);
  }

  .site-header__mobile-link {
    display: block;
    text-align: center;
    padding: clamp(0.85rem, 2.5vh, 1.1rem) 1.25rem;
    color: #fff;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 5vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .site-header__mobile-link:active {
    background: rgba(255, 255, 255, 0.08);
  }

  .site-header__mobile-cta {
    display: flex;
    justify-content: center;
    width: 100%;
    padding-inline: 1.25rem;
    margin-top: 0.5rem;
  }

  .site-header__mobile-cta-btn {
    display: block;
    width: 100%;
    max-width: 320px;
    text-align: center;
    padding: 1rem 2rem;
    background: var(--cta);
    color: #fff;
    text-decoration: none;
    font-size: 1rem;
    font-weight: 700;
    border-radius: 0.5rem;
  }

  .site-header__mobile-cta-btn:active {
    background: #12813c;
  }

  @media (max-width: 380px) {
    .site-header__brand {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header--reveal-after-hero,
    .site-header__hamburger span,
    .site-header__mobile {
      transition: none;
    }
  }

  /* Instant close / bfcache restore — do not animate into Safari's snapshot. */
  .site-header--no-motion.site-header--reveal-after-hero,
  .site-header--no-motion .site-header__hamburger span,
  .site-header--no-motion .site-header__mobile {
    transition: none;
  }

  /* iOS WebKit mis-paints a sticky bar when the stuck state is recomputed
     during history-restored scrolling; pin it and reserve its height instead. */
  @media (max-width: 899px) {
    .site-header {
      position: fixed;
      inset-inline: 0;
    }

    .site-header__spacer {
      display: block;
      height: 4.5rem;
    }
  }

  @media (min-width: 900px) {
    .site-header__nav {
      padding-inline: 2.5rem;
    }

    .site-header__links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      min-width: 0;
    }

    .site-header__link,
    .site-header__parent {
      padding-inline: 0.6rem;
      font-size: 0.875rem;
    }

    .site-header__actions {
      margin-left: 0.5rem;
    }

    .site-header__hamburger,
    .site-header__mobile {
      display: none;
    }
  }

  @media (min-width: 1100px) {
    .site-header__link,
    .site-header__parent {
      padding-inline: 0.75rem;
      font-size: 0.9375rem;
    }
  }
</style>
