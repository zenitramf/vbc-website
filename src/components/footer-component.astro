---
import { churchInfo, serviceTimes } from "@/lib/church-data";
import { footerNav } from "@/lib/site-nav";

const { sundayMorning } = serviceTimes;
---

<footer class="bg-foreground px-8 py-16 text-background md:px-16 lg:px-24">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 grid grid-cols-1 gap-12 md:grid-cols-4">
      <div class="flex flex-col gap-4 md:col-span-1">
        <img
          src="/vbc_logo.svg"
          alt="Victory Baptist Church"
          width="48"
          height="48"
          class="h-12 w-12 brightness-0 invert"
        />
        <address class="text-sm not-italic leading-relaxed text-background/70">
          {churchInfo.name}<br />
          <a
            href={churchInfo.mapsUrl}
            class="transition-colors hover:text-background"
          >
            {churchInfo.addressLine1}<br />
            {churchInfo.addressLine2}
          </a><br />
          <a
            href={`tel:${churchInfo.phoneE164}`}
            class="transition-colors hover:text-background"
          >
            {churchInfo.phone}
          </a>
        </address>
        <p class="text-sm text-background/70">
          Sunday Service — {sundayMorning.time}
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <h3
          class="text-sm font-semibold uppercase tracking-widest text-background/50"
        >
          Visit
        </h3>
        <nav class="flex flex-col gap-2">
          {
            footerNav.visit.map((link) => (
              <a
                href={link.href}
                class="text-sm text-background/80 transition-colors hover:text-background"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="flex flex-col gap-3">
        <h3
          class="text-sm font-semibold uppercase tracking-widest text-background/50"
        >
          Connect
        </h3>
        <nav class="flex flex-col gap-2">
          {
            footerNav.connect.map((link) => (
              <a
                href={link.href}
                class="text-sm text-background/80 transition-colors hover:text-background"
                target={
                  "external" in link && link.external ? "_blank" : undefined
                }
                rel={
                  "external" in link && link.external
                    ? "noopener noreferrer"
                    : undefined
                }
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="flex flex-col gap-3">
        <h3
          class="text-sm font-semibold uppercase tracking-widest text-background/50"
        >
          More
        </h3>
        <nav class="flex flex-col gap-2">
          {
            footerNav.more.map((link) => (
              <a
                href={link.href}
                class="text-sm text-background/80 transition-colors hover:text-background"
              >
                {link.label}
              </a>
            ))
          }
          <a
            href={`mailto:${churchInfo.email}`}
            class="text-sm text-background/80 transition-colors hover:text-background"
          >
            {churchInfo.email}
          </a>
        </nav>
      </div>
    </div>

    <p class="text-center text-sm text-background/40">
      &copy; {new Date().getFullYear()} Victory Baptist Church. All rights reserved.
    </p>
  </div>
</footer>
