---
import PageLayout from "@/layouts/page-layout.astro";
import PageHeader from "@/components/page-header.astro";
import { Button } from "@/components/starwind/button";
import { churchInfo } from "@/lib/church-data";
import pastorWillisPhoto from "@/images/rwillis_profile.webp";
import andrewMunizPhoto from "@/images/andrew_profile.webp";

const pastorWillisBio = [
  "Pastor Willis began serving at Victory Baptist Church while still attending college in 2011. Upon graduation in 2012, Pastor Willis moved to Fresno and served as the assistant pastor.",
  "During that time, he has been involved in various ministries at Victory Baptist Church. These ministries include children, youth, outreach, discipleship, preaching, teaching, and counseling.",
  "In 2021 Pastor Willis became the senior pastor of Victory Baptist Church. Pastor Willis serves with his wife Kali and their five children. They have been married for eight years.",
  "Pastor Willis is committed to faithfully and Biblically serving the Victory Baptist Church and the Fresno community.",
];

const andrewMunizBio = [
  "Andrew Muniz came to Christ in 2021 at Teen Camp and soon after surrendered his life to vocational ministry. He currently interns at Victory Baptist Church, serving in Spanish Ministry and Evangelism.",
  "Through Saturday outreach and Spanish translation, Andrew helps Spanish-speaking neighbors hear the gospel and connect with the life of the church in Fresno.",
];
---

<PageLayout
  title="Meet The Staff"
  description="Meet Pastor Ryan Willis, Andrew Muniz, and the staff of Victory Baptist Church in Fresno."
>
  <PageHeader eyebrow="Leadership" title="Meet The Staff">
    <p>
      Get to know our pastor and the ministry leaders who serve at Victory
      Baptist Church and Fresno with humility and love.
    </p>
  </PageHeader>

  <section class="bg-background px-8 py-16 md:px-16 lg:px-24">
    <div class="mx-auto flex max-w-3xl flex-col gap-16">
      <article>
        <div class="mb-8 flex items-center gap-5">
          <div
            class="relative size-24 shrink-0 overflow-hidden rounded-full border-[3px] border-primary md:size-28"
          >
            <img
              src={pastorWillisPhoto.src}
              width={112}
              height={112}
              alt=""
              class="absolute left-1/2 top-1/2 h-[120%] w-[120%] max-w-none -translate-x-[50%] -translate-y-[54%] object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
          <div>
            <p
              class="mb-1 text-sm font-semibold uppercase tracking-widest text-primary"
            >
              Senior Pastor
            </p>
            <h2
              class="font-display text-3xl font-bold text-foreground md:text-4xl"
            >
              Pastor Ryan Willis
            </h2>
          </div>
        </div>
        <div class="space-y-5 text-lg leading-relaxed text-muted-foreground">
          {pastorWillisBio.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </article>

      <article>
        <div class="mb-8 flex items-center gap-5">
          <img
            src={andrewMunizPhoto.src}
            width={112}
            height={112}
            alt=""
            class="size-24 shrink-0 rounded-full border-[3px] border-primary object-cover object-top md:size-28"
            loading="eager"
            decoding="async"
          />
          <div>
            <p
              class="mb-1 text-sm font-semibold uppercase tracking-widest text-primary"
            >
              Spanish Ministry / Evangelism
            </p>
            <h2
              class="font-display text-3xl font-bold text-foreground md:text-4xl"
            >
              Andrew Muniz
            </h2>
          </div>
        </div>
        <div class="space-y-5 text-lg leading-relaxed text-muted-foreground">
          {andrewMunizBio.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </article>

      <div class="flex flex-wrap gap-3 border-t border-border pt-10">
        <Button href={`mailto:${churchInfo.email}`} size="lg">Contact Us</Button
        >
        <Button href="/visit/" variant="secondary" size="lg"
          >Plan a Visit</Button
        >
      </div>
    </div>
  </section>
</PageLayout>
