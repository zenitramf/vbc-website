---
import PageLayout from "@/layouts/page-layout.astro";
---

<PageLayout title="Privacy Policy | Victory Baptist Church">
  <section class="bg-background px-8 py-16 md:px-16 lg:px-24">
    <div class="mx-auto max-w-3xl">
      <h1 class="mb-6 font-display text-4xl font-bold text-foreground">
        Privacy Policy
      </h1>
      <p class="text-muted-foreground leading-relaxed">
        Victory Baptist Church respects your privacy. Information you share through
        contact forms or visit planning is used only to respond to your request and
        to serve our church family. We do not sell personal information.
      </p>
    </div>
  </section>
</PageLayout>
