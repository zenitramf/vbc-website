---
import PageLayout from "@/layouts/page-layout.astro";
import PageHeader from "@/components/page-header.astro";
import UpcomingEvents from "@/components/upcoming-events.astro";
import Skeleton from "@/components/starwind/skeleton/Skeleton.astro";
import { Button } from "@/components/starwind/button";
---

<PageLayout
  title="Events"
  description="Upcoming events at Victory Baptist Church in Fresno."
>
  <PageHeader eyebrow="Calendar" title="Events">
    <p>
      From weekly services to outreach nights and special gatherings, there is
      always a place for you at VBC.
    </p>
  </PageHeader>

  <section class="bg-background px-8 py-16 md:px-16 lg:px-24">
    <div class="mx-auto max-w-3xl space-y-8">
      <article class="border-border pt-6">
        <h2 class="mb-2 font-display text-2xl font-bold text-foreground">
          Weekly Services
        </h2>
        <p class="text-muted-foreground leading-relaxed">
          Join us Sunday morning, Sunday night, and Thursday for Bible study and
          worship.
        </p>
      </article>

      <article class="border-t border-border pt-6">
        <h2 class="mb-2 font-display text-2xl font-bold text-foreground">
          Soul-Winning Outreach
        </h2>
        <p class="mb-4 text-muted-foreground leading-relaxed">
          Weekly door-to-door evangelism and community outreach throughout the
          year. Ask a greeter how to get involved.
        </p>
        <Button href="/#soul-winning" variant="cta">Learn About Outreach</Button
        >
      </article>

      <section
        class="border-t border-border pt-6"
        aria-labelledby="upcoming-events"
      >
        <h2
          id="upcoming-events"
          class="mb-4 font-display text-2xl font-bold text-foreground"
        >
          Upcoming Events
        </h2>
        <UpcomingEvents server:defer>
          <div
            slot="fallback"
            class="space-y-4"
            role="status"
            aria-live="polite"
            aria-label="Loading upcoming events"
          >
            {
              [0, 1, 2].map(() => (
                <div class="rounded-lg border border-border bg-muted/40 p-5">
                  <Skeleton class="h-6 w-3/4" />
                  <Skeleton class="mt-3 h-4 w-1/2" />
                  <Skeleton class="mt-3 h-4 w-2/3" />
                </div>
              ))
            }
            <span class="sr-only">Loading upcoming events…</span>
          </div>
        </UpcomingEvents>
      </section>
    </div>
  </section>
</PageLayout>
