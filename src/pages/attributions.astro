---
import PageLayout from "@/layouts/page-layout.astro";
---

<PageLayout title="Attributions | Victory Baptist Church">
  <section class="bg-background px-8 py-16 md:px-16 lg:px-24">
    <div class="mx-auto max-w-3xl">
      <h1 class="mb-6 font-display text-4xl font-bold text-foreground">
        Attributions
      </h1>
      <p class="text-muted-foreground leading-relaxed">
        This site uses open-source tools and licensed assets as noted in our
        project dependencies. Photography placeholders may come from Unsplash and
        are credited according to their license terms.
      </p>
    </div>
  </section>
</PageLayout>
