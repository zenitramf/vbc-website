---
import PageLayout from "@/layouts/page-layout.astro";
---

<PageLayout
  title="Terms of Use"
  description="Review the terms governing use of the Victory Baptist Church website and its content."
>
  <section class="bg-background px-8 py-16 md:px-16 lg:px-24">
    <div class="mx-auto max-w-3xl">
      <h1 class="mb-6 font-display text-4xl font-bold text-foreground">
        Terms of Use
      </h1>
      <p class="text-muted-foreground leading-relaxed">
        Content on this website is provided by Victory Baptist Church for
        general information and ministry purposes. Sermon media and written
        materials remain the property of the church unless otherwise noted.
        Please contact us before republishing content.
      </p>
    </div>
  </section>
</PageLayout>
