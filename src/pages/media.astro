---
import PageLayout from "@/layouts/page-layout.astro";
import PageHeader from "@/components/page-header.astro";
import { Button } from "@/components/starwind/button";
---

<PageLayout
  title="Media | Victory Baptist Church"
  description="Sermons, livestreams, and media from Victory Baptist Church."
>
  <PageHeader eyebrow="Watch & Listen" title="Media">
    <p>
      Find recent sermons, livestreams, and teaching resources from Victory
      Baptist Church.
    </p>
  </PageHeader>

  <section class="bg-background px-8 py-16 md:px-16 lg:px-24">
    <div class="mx-auto max-w-3xl">
      <p class="mb-8 text-muted-foreground leading-relaxed">
        Browse our sermon archive for the latest messages, or plan a visit to
        worship with us in person.
      </p>
      <div class="flex flex-wrap gap-3">
        <Button href="/sermons/" size="lg">Browse Sermons</Button>
        <Button href="/visit/" variant="secondary" size="lg">Visit Us</Button>
      </div>
    </div>
  </section>
</PageLayout>
