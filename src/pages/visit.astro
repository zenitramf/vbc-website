---
import PageLayout from "@/layouts/page-layout.astro";
import PageHeader from "@/components/page-header.astro";
import { Button } from "@/components/starwind/button";
import { churchInfo, serviceTimes } from "@/lib/church-data";

const faqs = [
  {
    answer:
      "We provide classes for children and teens during our 10am Sunday school hour. We believe that family worship is important, and focus on this during our 11am service.",
    question: "Do you have programs for my child/teen?",
  },
  {
    answer:
      "Nursery care is provided for all children during all services, newborn through three years of age.",
    question: "Do you have a nursery?",
  },
  {
    answer:
      "Don't worry! Our hospitality team will be waiting and ready for you to arrive. They will be able to give you direction and will have a gift bag prepared for each first time guest.",
    question: "Where do I go when I get there?",
  },
  {
    answer:
      "We don't have any type of restrictions or requirements, but we would ask you to remember that church is a family environment focused on worshipping God. Keep that in mind, and you will be fine!",
    question: "What should I wear?",
  },
  {
    answer:
      "No! If you are visiting we want the service to be a gift to you. You are welcome to give if you wish to, but we will never pressure you to do so.",
    question: "Am I expected to give to the offering?",
  },
];
---

<PageLayout
  title="Plan Your Visit"
  description="Plan your visit to Victory Baptist Church in Fresno — service times, directions, and what to expect."
>
  <PageHeader eyebrow="Welcome" title="Plan Your Visit">
    <p>
      Come as you are. Find a seat, meet friendly faces, and hear the gospel
      preached clearly from Scripture.
    </p>
  </PageHeader>

  <section class="bg-background px-8 py-16 md:px-16 lg:px-24">
    <div class="mx-auto grid max-w-5xl gap-12 md:grid-cols-2">
      <div>
        <h2 class="mb-6 font-display text-2xl font-bold text-foreground">
          Service Times
        </h2>
        <div class="space-y-8">
          <div>
            <h3
              class="mb-3 text-sm font-semibold uppercase tracking-widest text-primary"
            >
              Sundays
            </h3>
            <ul class="space-y-3 text-muted-foreground">
              <li>
                <strong class="text-foreground">Sunday School</strong> —{" "}
                {serviceTimes.sundaySchool.time}
              </li>
              <li>
                <strong class="text-foreground">Sunday Worship</strong> —{" "}
                {serviceTimes.sundayMorning.time}
              </li>
              <li>
                <strong class="text-foreground">Sunday Evening</strong> —{" "}
                {serviceTimes.sundayNight.time}
              </li>
            </ul>
          </div>
          <div>
            <h3
              class="mb-3 text-sm font-semibold uppercase tracking-widest text-primary"
            >
              Thursdays
            </h3>
            <ul class="space-y-3 text-muted-foreground">
              <li>
                <strong class="text-foreground">Bible Study</strong> —{" "}
                {serviceTimes.bibleStudy.time}
              </li>
              <li>
                <strong class="text-foreground">Children's Class</strong> —{" "}
                {serviceTimes.bibleStudy.time}
              </li>
            </ul>
          </div>
        </div>
      </div>
      <div>
        <h2 class="mb-5 font-display text-2xl font-bold text-foreground">
          Location
        </h2>
        <p class="mb-2 text-muted-foreground leading-relaxed">
          {churchInfo.addressLine1}<br />
          {churchInfo.addressLine2}
        </p>
        <p class="mb-6 text-sm text-muted-foreground">
          Located in the Gateway Business Complex
        </p>
        <div class="flex flex-wrap gap-3">
          <Button href={churchInfo.mapsUrl} size="lg">
            Open in Google Maps
          </Button>
          <Button
            href={`mailto:${churchInfo.email}`}
            variant="secondary"
            size="lg"
          >
            Contact Us
          </Button>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-muted px-8 py-16 md:px-16 lg:px-24">
    <div class="mx-auto max-w-3xl">
      <h2
        class="mb-8 font-display text-3xl font-bold text-foreground md:text-4xl"
      >
        What to Expect
      </h2>
      <div class="space-y-8">
        {
          faqs.map((faq) => (
            <div>
              <h3 class="mb-2 text-lg font-semibold text-foreground">
                {faq.question}
              </h3>
              <p class="leading-relaxed text-muted-foreground">{faq.answer}</p>
            </div>
          ))
        }
        <div>
          <h3 class="mb-2 text-lg font-semibold text-foreground">
            What do you believe?
          </h3>
          <p class="mb-4 leading-relaxed text-muted-foreground">
            Learn more about our purpose and beliefs.
          </p>
          <Button href="/about-vbc/" variant="secondary">Learn More</Button>
        </div>
        <div>
          <h3 class="mb-2 text-lg font-semibold text-foreground">
            I still have questions.
          </h3>
          <p class="mb-4 leading-relaxed text-muted-foreground">
            We would be glad to assist you in answering any further questions
            you might have.
          </p>
          <Button href={`mailto:${churchInfo.email}`} variant="cta" size="lg">
            Contact Us
          </Button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
