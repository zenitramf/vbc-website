---
// oxlint-disable import/no-relative-parent-imports
import MainLayout from "../layouts/main-layout.astro";
import SiteHeader from "../components/site-header.astro";
import HeroComponent from "../components/hero-component.astro";
import MinistriesSection from "../components/ministries-section.astro";
import AboutSection from "../components/about-section.astro";
import PlanVisitSection from "../components/plan-visit-section.astro";
import StaffCalendarSection from "../components/staff-calendar-section.astro";
import GivingSection from "../components/giving-section.astro";
import FooterComponent from "../components/footer-component.astro";
import heroBg from "@/images/home-page_fvbc_hero.webp";
import { churchOrganizationLd } from "@/lib/seo";
---

<MainLayout
  title="Fresno Victory Baptist Church"
  titleTemplate={false}
  jsonLd={churchOrganizationLd()}
>
  <Fragment slot="head-extra">
    <link rel="preload" as="image" href={heroBg.src} fetchpriority="high" />
  </Fragment>
  <SiteHeader mobileOnly />
  <main id="main-content" class="site-main" tabindex="-1">
    <HeroComponent />
    <MinistriesSection />
    <AboutSection />
    <PlanVisitSection />
    <StaffCalendarSection />
    <GivingSection />
  </main>
  <FooterComponent />
</MainLayout>
