---
import "@/styles/starwind.css";

import BaseHead from "@/components/base-head.astro";
import { churchInfo } from "@/lib/church-data";
import { buildSEO } from "@/lib/seo";
import type { SEOInput } from "@/lib/seo";

interface Props extends SEOInput {
  currentUrl?: URL;
}

const { currentUrl, ...seoInput }: Props = Astro.props;
const seo = buildSEO(seoInput);
---

<html lang="en" style={`--browser-chrome-tint: ${churchInfo.themeColor}`}>
  <head>
    <BaseHead {...seo} currentUrl={currentUrl ?? Astro.url} />
    <slot name="head-extra" />
  </head>
  <body class="font-sans antialiased">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>

<style is:global>
  /*
    Safari 26+ ignores theme-color and html background. It samples
    fixed/sticky backgrounds near the viewport edge, then body.
    Body must be the header navy so the iOS status bar matches.
  */
  body {
    background-color: var(--browser-chrome-tint, #0f2744);
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.7rem 1rem;
    border-radius: 0.35rem;
    color: #0f2744;
    background: #fff;
    box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.24);
    font-size: 0.875rem;
    font-weight: 800;
    text-decoration: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms ease;
  }

  .skip-link:focus-visible {
    outline: 3px solid #f4d58d;
    outline-offset: 3px;
    opacity: 1;
    pointer-events: auto;
  }

  .site-main:focus {
    outline: none;
  }

  @media (hover: none) and (pointer: coarse) {
    .skip-link {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }
</style>
