---
import MainLayout from "@/layouts/main-layout.astro";
import SiteHeader from "@/components/site-header.astro";
import FooterComponent from "@/components/footer-component.astro";
import type { SEOInput } from "@/lib/seo";

type Props = SEOInput;

const seoInput: Props = Astro.props;
---

<MainLayout {...seoInput} currentUrl={Astro.url}>
  <SiteHeader />
  <main id="main-content" class="site-main" tabindex="-1">
    <slot />
  </main>
  <FooterComponent />
</MainLayout>
