---
import MainLayout from "@/layouts/main-layout.astro";
import SiteHeader from "@/components/site-header.astro";
import FooterComponent from "@/components/footer-component.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description }: Props = Astro.props;
---

<MainLayout title={title}>
  {
    description && (
      <Fragment slot="head">
        <meta name="description" content={description} />
      </Fragment>
    )
  }
  <SiteHeader />
  <main id="main-content" class="site-main" tabindex="-1">
    <slot />
  </main>
  <FooterComponent />
</MainLayout>
