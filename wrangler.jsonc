/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vbc-website",
  "account_id": "23f99d3ef188b488e18827b853b73295",
  "main": "./src/worker.ts",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    // Astro SSR misdetects Node when process v2 is enabled; bodies become "[object Object]".
    // https://github.com/withastro/astro/issues/14511
    "disable_nodejs_process_v2",
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  "triggers": {
    // Daily sync of YouTube Videos into D1 (UTC noon).
    "crons": ["0 12 * * *"],
  },
  "r2_buckets": [
    {
      "bucket_name": "fvbc-images",
      "binding": "fvbc_images",
      // Use local R2 emulation for builds/dev without Wrangler login.
      // Set "remote": true when you need live bucket access in wrangler dev.
      "remote": false,
    },
  ],
  "d1_databases": [
    {
      "binding": "fvbc_sermons",
      "database_name": "fvbc-sermons",
      "database_id": "92b00b5a-5d2c-40a0-91b2-1936bfbd2a6a",
      "migrations_dir": "migrations",
    },
  ],
}
